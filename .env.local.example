# ─────────────────────────────────────────────────────────
# FSOS Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ─────────────────────────────────────────────────────────

# Supabase — get from supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Key — server-side ONLY, never expose to client
SUPABASE_SERVICE_KEY=your-service-key-here

# Anthropic — get from console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-key-here

# Resend — get from resend.com → API Keys
RESEND_API_KEY=your-resend-key-here
# MUST be an address on a Resend-VERIFIED sending domain (SPF/DKIM/DMARC passing).
# A placeholder containing "yourdomain.com" fails closed — live email will not send.
RESEND_FROM_EMAIL=hello@yourverifieddomain.com
# Reply-To for marketing email — a monitored inbox. Defaults to CONTACT.email (site.ts)
# when unset. Set to route replies where a human reads them (CAN-SPAM: functioning reply).
RESEND_REPLY_TO=hello@yourverifieddomain.com
# HMAC secret for signing one-click (RFC 8058) unsubscribe URLs. Prevents the public
# List-Unsubscribe endpoint from being abused to suppress arbitrary contacts. If unset,
# falls back to RESEND_WEBHOOK_SECRET; if neither is set, one-click runs in degraded
# (unsigned-accepted) mode — set this before production.
UNSUBSCRIBE_SECRET=replace-with-a-long-random-string
# Recipient for the AI morning briefing (POST /api/briefing/send). Defaults to RESEND_FROM_EMAIL.
BRIEFING_TO_EMAIL=you@yourdomain.com

# App URL — your Vercel deployment URL
NEXT_PUBLIC_URL=https://your-app.vercel.app

# Appointment booking is native to FSOS (ADR-027) — no third-party scheduler.
# Optional: connect the FSA's Google Calendar for one-way, read-only busy-sync so
# the availability engine blocks time the FSA is already busy (Slice 7). Scope is
# calendar.readonly ONLY — FSOS never writes to Google.
# GOOGLE_CALENDAR_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CALENDAR_CLIENT_SECRET=your-google-oauth-client-secret
# BOOKING_CALENDAR_TOKEN_KEY=change-me-strong-random   # pgcrypto key for the stored OAuth token

# Public marketing header/footer brand mark. Defaults OFF (the FSA's own shield
# renders). Set to 1 ONLY after Farmers brand + FINRA principal approval AND after
# placing the approved transparent asset at public/images/farmers-logo.svg.
NEXT_PUBLIC_USE_FARMERS_LOGO=0

# Twilio — direct SMS (replaces GHL LeadConnector SMS)
# twilio.com → Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+14695550001
# Optional: use a Messaging Service (number pool + built-in opt-out) instead of a single number.
TWILIO_MESSAGING_SERVICE_SID=
# A2P 10DLC go-live flag (Slice 7). SMS is HELD (queued, never sent) until this is "true".
# Leave false/unset while the A2P 10DLC brand+campaign is pending carrier approval; flip to
# "true" the moment approval lands and SMS activates on the next dispatch cycle — no rebuild.
# Enforced in the send-time gate (step `sms_live`), the drip runner, and the SMS provider.
SMS_A2P_APPROVED=false
# Inbound SMS webhook (Twilio Console → Phone Number → Messaging → "A message comes in"):
#   POST https://<your-domain>/api/webhooks/twilio/inbound
# Delivery-status callback is set automatically per-send to /api/webhooks/twilio/status.

# ── Two-way email + tracking ──────────────────────────────────────────────
# Public base URL used to build email open/click tracking links + Twilio callbacks.
NEXT_PUBLIC_APP_URL=https://your-domain.com
# Resend event webhook (Resend dashboard → Webhooks → signing secret). Powers
# delivered/opened/clicked/bounced/complained tracking → /api/webhooks/resend
RESEND_WEBHOOK_SECRET=whsec_your-resend-signing-secret
# Inbound email replies → /api/webhooks/email/inbound. Set a shared secret (sent as
# Authorization: Bearer <secret> or x-inbound-secret) OR rely on the Resend signature.
EMAIL_INBOUND_SECRET=your-inbound-email-shared-secret

# Retell AI — voice agents (replaces GHL AI Employee for inbound/outbound calls)
# retellai.com → Dashboard → API Key. Used for agent config; not wired into API routes yet.
RETELL_API_KEY=your-retell-api-key

# ─────────────────────────────────────────────────────────
# GoHighLevel — pipeline & workflow engine (WF-0…WF-43)
# Location: Markist Athelus Agency. Leave GHL_API_KEY blank to disable all GHL
# writes (the app degrades gracefully; the referral sync and /api/ghl/sync
# no-op). The inbound webhook still records events when a secret is set.
# ─────────────────────────────────────────────────────────
# Private Integration / API token (Settings → Private Integrations, scopes:
# contacts.write, opportunities.write, conversations.write). LeadConnector v2.
GHL_API_KEY=your-ghl-private-integration-token
# Sub-account (location) id — defaults to ATDNO1e5d27nj5t8vId3 if unset.
GHL_LOCATION_ID=ATDNO1e5d27nj5t8vId3
# Shared secret used to HMAC-SHA256-verify inbound webhooks (x-ghl-signature).
GHL_WEBHOOK_SECRET=your-ghl-webhook-secret

# ─────────────────────────────────────────────────────────
# Auth gate — protects the command-center UI and internal API routes
# ─────────────────────────────────────────────────────────

# Basic-auth username for the command-center login gate. Defaults to `markist`.
FSOS_ADMIN_USER=markist

# Basic-auth password. SET THIS to enable the command-center login gate
# (middleware) and internal-API protection. Leave blank to keep everything open
# (e.g. local dev). Setting either this or FSOS_API_SECRET turns protection on.
FSOS_ADMIN_PASSWORD=

# Bearer token that server-to-server callers (Make.com scenarios, cron jobs)
# send as `Authorization: Bearer <value>` to reach internal API routes.
# Use any long random string.
FSOS_API_SECRET=your-internal-api-secret

# Apollo.io — contact enrichment (title, company, LinkedIn). Get from
# apollo.io → Settings → Integrations → API. Leave blank to disable the
# "Enrich" action (it degrades gracefully).
APOLLO_API_KEY=your-apollo-api-key

# ─────────────────────────────────────────────────────────
# Zoom — virtual workshop delivery (P3): per-registrant join links + attendance webhook.
# CREDENTIAL-GATED: leave ALL of these blank to disable the Zoom integration entirely.
# With no credentials, provisioning is a clean no-op (registration still succeeds; join
# links provisioned later on retry) and the webhook endpoint fails closed in production.
# NO securities data is ever sent to Zoom (name + email only).
# ─────────────────────────────────────────────────────────
# Server-to-Server OAuth app (Zoom Marketplace → Build App → Server-to-Server OAuth).
# Scopes needed: meeting:write:admin (registrant create), webinar:write:admin (if webinars).
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
# Event Subscription "Secret Token" (Zoom app → Feature → Event Subscriptions). Used to
# answer the URL-validation (CRC) challenge and to HMAC-verify every inbound event at
# POST https://<your-domain>/api/webhooks/zoom. Subscribe the participant events:
#   meeting.participant_joined / meeting.participant_left
#   webinar.participant_joined / webinar.participant_left  (if using webinars)
ZOOM_WEBHOOK_SECRET_TOKEN=your-zoom-webhook-secret-token

# ─────────────────────────────────────────────────────────
# Social Media Center — account connection (ADR-026). Publishing to a platform
# requires connecting an account via OAuth at /app/social/accounts. Leave a
# platform's credentials blank to keep it in a labeled "not configured" state
# (the connect button explains what to set — the app never crashes or invents an
# integration). Register the redirect URI with each provider EXACTLY as:
#   ${NEXT_PUBLIC_APP_URL}/api/social/oauth/youtube/callback
#   ${NEXT_PUBLIC_APP_URL}/api/social/oauth/facebook_page/callback
# ─────────────────────────────────────────────────────────
# YouTube (Google Cloud → APIs & Services → Credentials → OAuth client, type "Web").
# Scopes: youtube.upload, youtube.readonly.
SOCIAL_YOUTUBE_CLIENT_ID=your-google-oauth-client-id
SOCIAL_YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
# Facebook Page (Meta for Developers → App → Facebook Login → Settings).
# Permissions: pages_manage_posts, pages_read_engagement, pages_show_list, read_insights.
SOCIAL_FACEBOOK_APP_ID=your-meta-app-id
SOCIAL_FACEBOOK_APP_SECRET=your-meta-app-secret
# Symmetric key that encrypts stored OAuth tokens at rest (pgcrypto). REQUIRED in
# production — a stable, high-entropy secret; rotating it invalidates stored tokens.
SOCIAL_TOKEN_KEY=change-me-to-a-long-random-secret
# Optional: a distinct HMAC key for the OAuth CSRF state token (defaults to
# SOCIAL_TOKEN_KEY when unset).
# SOCIAL_OAUTH_STATE_KEY=change-me-to-another-long-random-secret
