# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
build/

# Environment — NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo

# Test compile output (tests/p0-gate.test.mjs)
.p0-out-*/

# Claude Code personal (per-developer) settings — never commit
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Rule-fetcher runtime audit log (generated per run)
data/rule_fetch_log.json

# Superpowers subagent-driven-development scratch (controller working state)
.superpowers/

# Deliverability skill helper-script output/cache (validate_dns.mjs / lint_email.mjs are
# stdout-only by design; this guards against any future local cache or report files)
.claude/skills/fsos-dns-auth/scripts/.cache/
.claude/skills/fsos-dns-auth/scripts/*.out.json
.claude/skills/fsos-email-template-qa/scripts/.cache/
.claude/skills/fsos-email-template-qa/scripts/*.out.json

# esbuild scratch dir used by tests/knowledge-library-documents.test.mjs (bundles must
# sit inside the repo so externalized provider SDKs resolve against node_modules).
.kld-test-*/

# esbuild/tsc scratch dirs used by the comms proofs (bundles must sit inside the repo so
# node_modules resolves for the modules they pull in).
.reply-cls-*/
.turn-limit-*/
.msgstatus-*/
.comms-out-*/

# Python analysis tooling
__pycache__/
*.pyc
.phase2/

# Playwright (Batch 8) — local run artifacts only.
/test-results/
/playwright-report/
